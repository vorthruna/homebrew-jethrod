def classify(address):
    """Return 'US' / 'CA' / 'MX' if the address is North American, else None."""
    if not address:
        return None
    a = address.strip()
    low = a.lower()
    # trailing ", XX" or ", XX 12345" / ", XX A1A 1A1"
    m = re.search(r",\s*([A-Z]{2})(?:\s+[\dA-Z][\dA-Z\- ]{2,9})?\s*$", a)
    if m:
        code = m.group(1)
        if code in US_STATES:
            return "US"
        if code in CA_PROVINCES:
            return "CA"
    for region, words in COUNTRY_WORDS.items():
        for w in words:
            if re.search(r"(^|[\s,])" + re.escape(w) + r"($|[\s,.])", low):
                return region
    parts = [p.strip() for p in low.split(",")]
    tail = parts[-1] if len(parts) > 1 else ""
    for name in US_STATES.values():
        n = name.lower()
        if tail == n and not (n == "georgia" and "tbilisi" in low):
            return "US"
    for name in CA_PROVINCES.values():
        if tail == name.lower():
            return "CA"
    for region, cities in NA_CITIES.items():
        for c in cities:
            if low == c or low.startswith(c + ","):
                return region
    return None


def looks_american_by_clock(attrs):
    """Evening shows west of UTC land late (or next day) in UTC.
    Europe's 19:00-21:00 local is 17:00-20:00Z; NA's 19:00-20:00 local is
    23:00-04:00Z. A fallback when the address says nothing useful."""
    if not attrs.get("is-starts-at-known"):
        return False
    try:
        utc = dt.datetime.strptime(attrs["starts-at"], "%Y-%m-%dT%H:%M:%SZ")
        local = dt.date.fromisoformat(attrs["starts-at-date-local"])
    except (KeyError, ValueError, TypeError):
        return False
    if utc.date() > local:
        return True
    return utc.date() == local and utc.hour >= 22


# ------------------------------------------------------------ config/state
def load_config():
    cfg = dict(DEFAULTS)
    try:
        with open(CONFIG_FILE) as fh:
            for line in fh:
                line = line.strip()
                if line and not line.startswith("#") and "=" in line:
                    k, v = line.split("=", 1)
                    cfg[k.strip()] = v.strip()
    except FileNotFoundError:
        pass
    for k in DEFAULTS:
        env = os.environ.get("JETHROD_" + k.upper())
        if env is not None:
            cfg[k] = env
    return cfg


def save_config_value(key, value):
    if key not in DEFAULTS:
        raise SystemExit("unknown key %r (known: %s)" % (key, ", ".join(DEFAULTS)))
    os.makedirs(os.path.dirname(CONFIG_FILE), exist_ok=True)
    lines, found = [], False
    try:
        with open(CONFIG_FILE) as fh:
            for line in fh:
                if line.split("=", 1)[0].strip() == key:
                    lines.append("%s=%s\n" % (key, value))
                    found = True
                else:
                    lines.append(line)
    except FileNotFoundError:
        pass
    if not found:
        lines.append("%s=%s\n" % (key, value))
    with open(CONFIG_FILE, "w") as fh:
        fh.writelines(lines)


def load_state():
    try:
        with open(STATE_FILE) as fh:
            return json.load(fh)
    except (FileNotFoundError, ValueError):
        return {"alerted": {}, "last_check": None, "last_total": None}


def save_state(state):
    os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
    tmp = STATE_FILE + ".tmp"
    with open(tmp, "w") as fh:
        json.dump(state, fh, indent=2, sort_keys=True)
    os.replace(tmp, STATE_FILE)


# ------------------------------------------------------------------- feed
def fetch(url):
    if url.startswith("file://"):
        with open(url[7:]) as fh:
            return json.load(fh)
    req = urllib.request.Request(url, headers={"User-Agent": UA,
                                               "Accept": "application/vnd.api+json"})
    with urllib.request.urlopen(req, timeout=20) as resp:
        return json.load(resp)


def events(doc):
    out = []
    for inc in doc.get("included", []):
        if inc.get("type") != "tour-events":
            continue
        a = inc.get("attributes", {})
        region = classify(a.get("formatted-address"))
        out.append({
            "id": inc.get("id"),
            "date": a.get("starts-at-date-local") or "?",
            "venue": a.get("venue-name") or "?",
            "where": a.get("formatted-address") or "?",
            "sold_out": bool(a.get("is-sold-out")),
            "region": region,
            "clock_hint": region is None and looks_american_by_clock(a),
        })
    out.sort(key=lambda e: e["date"])
    return out


def interesting(evts):
    return [e for e in evts if e["region"] in REGIONS or e["clock_hint"]]


def describe(e):
    tag = e["region"] or ("Americas? (by showtime)" if e["clock_hint"] else "")
    return "%s  %s - %s%s%s" % (e["date"], e["where"], e["venue"],
                                " [%s]" % tag if tag else "",
                                "  SOLD OUT" if e["sold_out"] else "")


# ---------------------------------------------------------------- alerts
def notify(cfg, title, body, log=print):
    sent = []
    if cfg.get("desktop", "on").lower() not in ("off", "0", "false", "no"):
        tn = shutil.which("terminal-notifier") or (
            "/opt/homebrew/bin/terminal-notifier"
            if os.path.exists("/opt/homebrew/bin/terminal-notifier") else None)
        try:
            if tn:
                subprocess.run([tn, "-title", title, "-message", body,
                                "-open", TOUR_PAGE, "-sound", "Glass",
                                "-group", "jethrod"], check=True,
                               capture_output=True, timeout=15)
                sent.append("terminal-notifier")
            elif sys.platform == "darwin":
                script = "display notification %s with title %s sound name \"Glass\"" % (
                    json.dumps(body), json.dumps(title))
                subprocess.run(["osascript", "-e", script], check=True,
                               capture_output=True, timeout=15)
                sent.append("osascript")
            elif shutil.which("notify-send"):
                subprocess.run(["notify-send", title, body], check=True,
                               capture_output=True, timeout=15)
                sent.append("notify-send")
        except (OSError, subprocess.SubprocessError) as exc:
            log("desktop notification failed: %s" % exc)
    topic = cfg.get("ntfy_topic", "").strip()
    if topic:
        url = "%s/%s" % (cfg.get("ntfy_server", DEFAULTS["ntfy_server"]).rstrip("/"), topic)
        req = urllib.request.Request(url, data=body.encode("utf-8"), headers={
            "Title": title.encode("utf-8").decode("latin-1", "ignore"),
            "Click": TOUR_PAGE, "Tags": "flute,tada", "Priority": "high",
            "User-Agent": UA})
        try:
            urllib.request.urlopen(req, timeout=20).read()
            sent.append("ntfy")
        except Exception as exc:  # noqa: BLE001 - never die on a push
            log("ntfy push failed: %s" % exc)
    return sent


# ------------------------------------------------------------------ core
def check_once(cfg, log=print, quiet=False):
    doc = fetch(cfg["feed"])
    evts = events(doc)
    state = load_state()
    fresh = [e for e in interesting(evts) if e["id"] not in state["alerted"]]
    state["last_check"] = dt.datetime.now(dt.timezone.utc).isoformat(timespec="seconds")
    state["last_total"] = len(evts)
    if fresh:
        title = "Jethro Tull in North America!" if len(fresh) == 1 else \
            "Jethro Tull: %d North American dates!" % len(fresh)
        body = "\n".join("%s %s - %s" % (e["date"], e["where"], e["venue"]) for e in fresh)
        channels = notify(cfg, title, body, log=log)
        for e in fresh:
            log("NEW  " + describe(e))
        log("alerted via: %s" % (", ".join(channels) or "nothing (no channel worked!)"))
        if channels:
            for e in fresh:
                state["alerted"][e["id"]] = describe(e)
    elif not quiet:
        log("%d dates on the books, none in North America. Still on one leg." % len(evts))
    save_state(state)
    return fresh, evts


def run_daemon(cfg):
    log = lambda m: print("[%s] %s" % (dt.datetime.now().strftime("%Y-%m-%d %H:%M:%S"), m), flush=True)
    try:
        minutes = max(5.0, float(cfg["interval_minutes"]))
    except ValueError:
        minutes = 30.0
    print(BANNER, flush=True)
    log("polling every %g min; ntfy %s" % (minutes, "on" if cfg.get("ntfy_topic") else "off"))
    while True:
        try:
            check_once(load_config(), log=log)
        except Exception as exc:  # noqa: BLE001 - daemon must keep breathing
            log("check failed: %s" % exc)
        time.sleep(minutes * 60 * random.uniform(0.9, 1.1))


def selftest():
    cases = {
        "Boston, MA": "US", "New York, NY 10019": "US", "Toronto, ON": "CA",
        "Toronto, ON M5V 3L9": "CA", "Vancouver, British Columbia": "CA",
        "Morrison, Colorado": "US", "Mexico City": "MX", "Guadalajara, Jalisco": "MX",
        "Austin, TX, USA": "US", "Montréal, Canada": "CA",
        "Bonn, Germany": None, "Ely, UK": None, "Bremen": None, "Padova": None,
        "Stuttgart, Baden-Württemberg": None, "Tbilisi, Georgia": None,
        "Uppsala, Uppsala County": None, "Vienna, Vienna": None,
    }
    bad = [(a, want, classify(a)) for a, want in cases.items() if classify(a) != want]
    us = {"is-starts-at-known": True, "starts-at": "2027-06-11T00:00:00Z",
          "starts-at-date-local": "2027-06-10"}
    eu = {"is-starts-at-known": True, "starts-at": "2027-03-06T18:30:00Z",
          "starts-at-date-local": "2027-03-06"}
    if not looks_american_by_clock(us) or looks_american_by_clock(eu):
        bad.append(("clock heuristic", "ok", "broken"))
    for a, want, got in bad:
        print("FAIL %r: want %r got %r" % (a, want, got))
    print("selftest: %d/%d ok" % (len(cases) + 1 - len(bad), len(cases) + 1))
    return 0 if not bad else 1


def main(argv=None):
    p = argparse.ArgumentParser(prog="jethrod", description=__doc__.split("\n")[0])
    p.add_argument("--version", action="version", version="jethrod " + VERSION)
    sub = p.add_subparsers(dest="cmd")
    sub.add_parser("run", help="run the daemon (what brew services uses)")
    sub.add_parser("check", help="check once now; exit 0, or 2 if new NA dates")
    sub.add_parser("status", help="show every booked date and what's been alerted")
    sub.add_parser("test-alert", help="fire a test notification on every channel")
    sub.add_parser("selftest", help="verify the geography logic")
    c = sub.add_parser("config", help="show config, or set KEY VALUE")
    c.add_argument("key", nargs="?")
    c.add_argument("value", nargs="?")
    sub.add_parser("forget", help="clear alert history (you'll be re-alerted)")
    args = p.parse_args(argv)
    cfg = load_config()

    if args.cmd == "run":
        run_daemon(cfg)
    elif args.cmd == "check":
        fresh, _ = check_once(cfg)
        return 2 if fresh else 0
    elif args.cmd == "status":
        evts = events(fetch(cfg["feed"]))
        state = load_state()
        print("%d booked dates (source: %s)\n" % (len(evts), TOUR_PAGE))
        for e in evts:
            mark = ">>" if (e["region"] or e["clock_hint"]) else "  "
            print(" %s %s" % (mark, describe(e)))
        print("\nalready alerted: %d   last daemon check: %s" % (
            len(state["alerted"]), state.get("last_check") or "never"))
        print("ntfy: %s   config: %s" % (cfg.get("ntfy_topic") or "off", CONFIG_FILE))
    elif args.cmd == "test-alert":
        ch = notify(cfg, "jethrod test", "Bungle in the jungle? No - just a test. "
                    "You'll hear it like this when Tull books North America.")
        print("sent via: %s" % (", ".join(ch) or "nothing"))
        return 0 if ch else 1
    elif args.cmd == "selftest":
        return selftest()
    elif args.cmd == "config":
        if args.key and args.value is not None:
            save_config_value(args.key, args.value)
            print("%s=%s  (restart: brew services restart jethrod)" % (args.key, args.value))
        else:
            for k in DEFAULTS:
                print("%s=%s" % (k, cfg.get(k, "")))
    elif args.cmd == "forget":
        save_state({"alerted": {}, "last_check": None, "last_total": None})
        print("forgot everything. Thick as a brick.")
    else:
        print(BANNER)
        p.print_help()
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except KeyboardInterrupt:
        sys.exit(130)
